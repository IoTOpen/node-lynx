{
  "name": "@iotopen/node-lynx",
  "version": "2.5.3",
  "description": "IoT Open Lynx API package for node",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint src --max-warnings 0 && pnpm type-check",
    "lint:fix": "eslint src --max-warnings 0 --fix && pnpm type-check",
    "type-check": "tsc --noEmit",
    "build": "rollup -c",
    "build:analyze": "ANALYZE=true rollup -c",
    "dev:ts": "rollup -c -w",
    "clean": "rm -rf dist",
    "prepare": "rm -rf dist/ && rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IoTOpen/node-lynx.git"
  },
  "keywords": [
    "lynx",
    "iot",
    "IoT Open"
  ],
  "author": "IoT Open",
  "license": "Apache 2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.19.3",
    "@types/sprintf-js": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "rollup": "^4.53.5",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "dependencies": {
    "cross-fetch": "^4.1.0",
    "js-base64": "^3.7.8",
    "sprintf-js": "^1.1.3",
    "tslib": "^2.8.1"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}
