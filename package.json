{
  "name": "@iotopen/node-lynx",
  "version": "2.5.3",
  "description": "IoT Open Lynx API package for node",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint --ext js,ts,tsx --max-warnings 0 src",
    "lint:fix": "eslint --ext js,ts,tsx --max-warnings 0 --fix src",
    "build": "rollup -c",
    "dev:ts": "rollup -c -w",
    "clean": "rm -rf dist",
    "prepare": "rm -rf dist/ && rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IoTOpen/node-lynx.git"
  },
  "keywords": [
    "lynx",
    "iot",
    "IoT Open"
  ],
  "author": "IoT Open",
  "license": "Apache 2.0",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^22.18.1",
    "@types/sprintf-js": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "rollup": "^4.50.1",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "dependencies": {
    "cross-fetch": "^3.2.0",
    "js-base64": "^3.7.8",
    "sprintf-js": "^1.1.3",
    "tslib": "^2.8.1"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}