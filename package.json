{
  "name": "@iotopen/node-lynx",
  "version": "2.6.0-rc",
  "description": "IoT Open Lynx API package for node",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0 && pnpm type-check",
    "lint:fix": "eslint src --max-warnings 0 --fix && pnpm type-check",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "build": "vite build --config ./vite.config.ts",
    "build:analyze": "ANALYZE=true vite build --config ./vite.config.ts",
    "dev:ts": "vite",
    "clean": "rm -rf dist",
    "prepare": "node scripts/prepare.cjs",
    "prepack": "node scripts/prepare.cjs",
    "prepublishOnly": "pnpm run build",
    "publish:prerelease": "pnpm version prerelease --preid=rc && pnpm run build && npm publish --tag rc"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IoTOpen/node-lynx.git"
  },
  "keywords": [
    "lynx",
    "iot",
    "IoT Open"
  ],
  "author": "IoT Open",
  "license": "Apache 2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.11",
    "@types/sprintf-js": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import-x": "^4.16.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "js-base64": "^3.7.8",
    "sprintf-js": "^1.1.3"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ]
}
